# Google Gemini API Key (for embeddings and LLM calls)
GOOGLE_API_KEY=your_google_api_key_here

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name
PINECONE_HOST=https://your-index-name.svc.your-region.pinecone.io

# MongoDB Connection String
MONGO_DB_API_KEY=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secret (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# Frontend URLs (used for CORS — only these origins can call the API)
LOCAL_FRONTEND_URL=http://localhost:3000
PROD_FRONTEND_URL=https://your-frontend-domain.vercel.app

# Extra allowed origins for local development, comma-separated (optional)
EXTRA_FRONTEND_URLS=

# Gemini model for answers (optional; defaults to gemini-flash-latest)
GEMINI_MODEL=
# Used when the main model is busy (optional; defaults to gemini-flash-lite-latest)
GEMINI_FALLBACK_MODEL=

# Password reset without email (on by default). Set to false to turn it off.
ALLOW_INSECURE_PASSWORD_RESET=true

# Production database (MongoDB Atlas), used when NODE_ENV=production
PROD_MONGO_DB_URI=
